{
  "cleanUrls": true,
  "crons": [{ "path": "/api/indexnow", "schedule": "0 10 * * *" }],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.selloapp.com.br" }],
      "destination": "https://selloapp.com.br/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ],
  "rewrites": [
    {
      "source": "/ocasioes/:ocasiao/:bairro",
      "destination": "/api/lugares?tipo=ocasiao&a=:ocasiao&b=:bairro"
    },
    {
      "source": "/ocasioes/:ocasiao",
      "destination": "/api/lugares?tipo=ocasiao&a=:ocasiao"
    },
    {
      "source": "/restaurantes/:cozinha/:bairro",
      "destination": "/api/lugares?tipo=combo&a=:cozinha&b=:bairro"
    },
    {
      "source": "/restaurantes/:cozinha",
      "destination": "/api/lugares?tipo=cozinha&a=:cozinha"
    },
    {
      "source": "/onde-comer/:bairro",
      "destination": "/api/lugares?tipo=bairro&a=:bairro"
    },
    {
      "source": "/guias",
      "destination": "/api/guias"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/download",
      "destination": "/api/app"
    },
    {
      "source": "/app",
      "destination": "/api/app"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/share?type=r&slug=:slug"
    },
    {
      "source": "/g/:slug",
      "destination": "/api/share?type=g&slug=:slug"
    },
    {
      "source": "/l/:slug",
      "destination": "/api/share?type=l&slug=:slug"
    },
    {
      "source": "/u/:slug",
      "destination": "/api/share?type=u&slug=:slug"
    }
  ]
}
