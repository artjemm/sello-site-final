{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    {
      "source": "/restaurantes/:cozinha/:bairro",
      "destination": "/api/lugares?tipo=combo&a=:cozinha&b=:bairro"
    },
    {
      "source": "/restaurantes/:cozinha",
      "destination": "/api/lugares?tipo=cozinha&a=:cozinha"
    },
    {
      "source": "/onde-comer/:bairro",
      "destination": "/api/lugares?tipo=bairro&a=:bairro"
    },
    {
      "source": "/guias",
      "destination": "/api/guias"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/download",
      "destination": "/api/app"
    },
    {
      "source": "/app",
      "destination": "/api/app"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/share?type=r&slug=:slug"
    },
    {
      "source": "/g/:slug",
      "destination": "/api/share?type=g&slug=:slug"
    },
    {
      "source": "/l/:slug",
      "destination": "/api/share?type=l&slug=:slug"
    },
    {
      "source": "/u/:slug",
      "destination": "/api/share?type=u&slug=:slug"
    }
  ]
}
